---
import { getEntry } from 'astro:content';
import type { AboutData } from '../content.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about.css';
import Nav from '../components/Nav.astro';
import CTAForm from '../components/CTAForm.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Editable from '../components/Editable.astro';
import { plain } from '../lib/plain';

const about = await getEntry('pages', 'about');
const { meta, hero, shortVersion, mission, team, story, cta } = about!.data as AboutData;
const file = 'src/content/pages/about.json';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <Nav current="/about" />

  <!-- Hero -->
  <section class="hero about-hero hero--indigo-purple" data-k-module-file={file} data-k-module-path="hero" data-k-module-label="Hero">
    <div class="hero-blob b1" aria-hidden="true">
      <svg viewBox="-20 -20 140 120" width="320" height="277" preserveAspectRatio="xMidYMid meet">
        {[
          { c:'#7118C2', s:32 }, { c:'#150352', s:26 }, { c:'#BC10DE', s:20 },
          { c:'#7118C2', s:14 }, { c:'#00FB90', s:8  }, { c:'#150352', s:4  }
        ].map((r, i) => {
          const inset = i * 5;
          const pts = [
            [25+inset*0.5, inset], [75-inset*0.5, inset],
            [100-inset, 43.3], [75-inset*0.5, 86.6-inset],
            [25+inset*0.5, 86.6-inset], [inset, 43.3]
          ].map(p => p.join(',')).join(' ');
          return <polygon points={pts} fill="none" stroke={r.c} stroke-width={r.s} stroke-linejoin="round" />;
        })}
      </svg>
    </div>
    <div class="hero-blob b2" aria-hidden="true">
      <svg viewBox="-14 -14 128 114" width="90" height="78">
        <polygon points="25,0 75,0 100,43.3 75,86.6 25,86.6 0,43.3" fill="#BC10DE" stroke="#BC10DE" stroke-width="22" stroke-linejoin="round" />
      </svg>
    </div>
    <div class="container hero-grid">
      <div>
        <Editable as="div" class="hero-eyebrow" kind="text" value={hero.eyebrow} file={file} path="hero.eyebrow" label="Hero eyebrow" />
        <Editable as="h1" class="hero-title" kind="html" value={hero.titleHtml} file={file} path="hero.titleHtml" label="Hero title" />
        <Editable as="p" class="hero-sub" kind="text" value={hero.sub} file={file} path="hero.sub" label="Hero subtitle" />
        <div class="hero-ctas">
          <a
            class="btn btn-lg btn-mint"
            href={hero.primaryCta.href}
            data-k-file={file}
            data-k-path="hero.primaryCta.label"
            data-k-value={hero.primaryCta.label}
            data-k-kind="text"
            data-k-label="Hero primary CTA label"
            data-k-href-path="hero.primaryCta.href"
            data-k-href-value={hero.primaryCta.href}
          >
            {hero.primaryCta.label}
            <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
          </a>
          <Editable
            as="a"
            class="btn btn-lg btn-ghost-dark"
            kind="text"
            value={hero.secondaryCta.label}
            file={file}
            path="hero.secondaryCta.label"
            hrefPath="hero.secondaryCta.href"
            hrefValue={hero.secondaryCta.href}
            href={hero.secondaryCta.href}
            label="Hero secondary CTA label"
          />
        </div>
      </div>
      <div class="hero-portrait about-hero-portrait">
        <img
          class="about-hero-img"
          src={hero.image.src}
          alt={hero.image.alt}
          width="660"
          height="auto"
          loading="eager"
          data-k-file={file}
          data-k-path="hero.image.alt"
          data-k-value={hero.image.alt}
          data-k-kind="text"
          data-k-label="Hero image alt text"
        />
      </div>
    </div>
  </section>

  <!-- Short version band -->
  <section class="about-short" data-k-module-file={file} data-k-module-path="shortVersion" data-k-module-label="Short version">
    <div class="container about-short-grid reveal">
      <Editable as="div" class="eyebrow" kind="text" value={shortVersion.eyebrow} file={file} path="shortVersion.eyebrow" label="Short version eyebrow" />
      <Editable as="p" class="about-short-lead" kind="html" value={shortVersion.leadHtml} file={file} path="shortVersion.leadHtml" label="Short version lead" />
    </div>
  </section>

  <!-- Mission / convictions -->
  <section class="about-mission" data-k-module-file={file} data-k-module-path="mission" data-k-module-label="Mission">
    <div class="container">
      <div class="section-head about-mission-head reveal">
        <Editable as="div" class="eyebrow" kind="text" value={mission.eyebrow} file={file} path="mission.eyebrow" label="Mission eyebrow" />
        <Editable as="h2" kind="html" value={mission.headingHtml} file={file} path="mission.headingHtml" label="Mission heading" />
      </div>
      <div class="conviction-grid">
        {mission.convictions.map((c, i) => (
          <article
            class="conviction-card reveal"
            style={`--cv-accent:${c.color};--reveal-delay:${i*85}ms`}
            data-k-module-file={file}
            data-k-module-path={`mission.convictions.${i}`}
            data-k-module-label={`Conviction ${i + 1}`}
          >
            <div class="conviction-num">
              <img class="conviction-icon" src={c.icon} alt="" width="56" height="56" loading="lazy" />
            </div>
            <Editable as="h3" class="conviction-title" file={file} path={`mission.convictions.${i}.title`} value={c.title} label="Conviction title" />
            <Editable as="p" class="conviction-body" file={file} path={`mission.convictions.${i}.body`} value={c.body} label="Conviction body" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Team / founders -->
  <section class="about-team" data-k-module-file={file} data-k-module-path="team" data-k-module-label="Team">
    <div class="container">
      <div class="section-head about-team-head reveal">
        <Editable as="div" class="eyebrow" kind="text" value={team.eyebrow} file={file} path="team.eyebrow" label="Team eyebrow" />
        <Editable as="h2" kind="html" value={team.headingHtml} file={file} path="team.headingHtml" label="Team heading" />
        <Editable as="p" class="about-team-intro" kind="html" value={team.introHtml} file={file} path="team.introHtml" label="Team intro" />
      </div>
      <div class="founder-list">
        {team.founders.map((p, i) => (
          <article
            class="founder-card reveal"
            style={`--reveal-delay:${i*90}ms`}
            data-k-module-file={file}
            data-k-module-path={`team.founders.${i}`}
            data-k-module-label={`Founder ${i + 1}`}
          >
            <div class="founder-photo-wrap">
              <img
                class="founder-photo"
                src={p.photo}
                alt={plain(p.name)}
                width="280"
                height="320"
                loading="lazy"
              />
            </div>
            <div class="founder-body">
              <Editable as="div" class="founder-title" file={file} path={`team.founders.${i}.title`} value={p.title} label="Founder title" />
              <Editable as="h3" class="founder-name" file={file} path={`team.founders.${i}.name`} value={p.name} label="Founder name" />
              {p.bio.map((para, j) => (
                <Editable as="p" class="founder-bio" file={file} path={`team.founders.${i}.bio.${j}`} value={para} label={`Founder bio paragraph ${j + 1}`} />
              ))}
              <div class="founder-firms">
                <span class="founder-firms-label">Experience</span>
                <div class="founder-firms-chips">
                  {p.firms.map((f, j) => (
                    <Editable as="span" class="firm-chip" file={file} path={`team.founders.${i}.firms.${j}`} value={f} label={`Founder firm ${j + 1}`} />
                  ))}
                </div>
              </div>
              <Editable as="div" class="founder-industries" file={file} path={`team.founders.${i}.industries`} value={p.industries} label="Founder industries" />
              <a class="leader-link founder-link" href={p.linkedin} target="_blank" rel="noopener noreferrer">
                Connect on LinkedIn <span class="ar">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="about-story" id="story" data-k-module-file={file} data-k-module-path="story" data-k-module-label="Story">
    <div class="container story-layout">
      <div class="story-col-left reveal">
        <Editable as="div" class="eyebrow story-eyebrow" kind="text" value={story.eyebrow} file={file} path="story.eyebrow" label="Story eyebrow" />
        <Editable as="h2" class="story-headline" kind="html" value={story.headingHtml} file={file} path="story.headingHtml" label="Story heading" />
        <blockquote class="hume-quote">
          <p>"<Editable as="span" value={story.quote.text} file={file} path="story.quote.text" label="Story quote text" />"</p>
          <Editable as="cite" kind="html" value={story.quote.citeHtml} file={file} path="story.quote.citeHtml" label="Story quote citation" />
        </blockquote>
        <div class="story-photo">
          <img
            class="story-img"
            src={story.image.src}
            alt={story.image.alt}
            width="520"
            height="400"
            loading="lazy"
            data-k-file={file}
            data-k-path="story.image.alt"
            data-k-value={story.image.alt}
            data-k-kind="text"
            data-k-label="Story image alt text"
          />
        </div>
      </div>
      <div class="story-col-right reveal">
        {story.paragraphs.map((para, i) => (
          <Editable as="p" class="story-para" file={file} path={`story.paragraphs.${i}`} value={para} label={`Story paragraph ${i + 1}`} />
        ))}
        <Editable as="p" class="story-para story-sign-line" kind="html" value={story.signOffHtml} file={file} path="story.signOffHtml" label="Story sign-off" />
        <Editable as="p" class="story-para" kind="html" value={story.closingParagraphHtml} file={file} path="story.closingParagraphHtml" label="Story closing paragraph" />
        <Editable as="div" class="story-signature" kind="text" value={story.signature} file={file} path="story.signature" label="Story signature" />
      </div>
    </div>
  </section>

  <CTAForm
    id={cta.id}
    formId={cta.formId}
    eyebrow={cta.eyebrow}
    heading={cta.headingHtml}
    subtitle={cta.subtitle}
  />

  <Footer />
  <ScrollReveal />
</BaseLayout>
