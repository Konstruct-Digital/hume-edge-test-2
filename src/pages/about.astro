---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about.css';
import Nav from '../components/Nav.astro';
import CTAForm from '../components/CTAForm.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const about = await getEntry('pages', 'about');
const { meta, hero, shortVersion, mission, team, story, cta } = about!.data;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <Nav current="About Us" />

  <!-- Hero -->
  <section class="hero about-hero hero--indigo-purple">
    <div class="hero-blob b1" aria-hidden="true">
      <svg viewBox="-20 -20 140 120" width="320" height="277" preserveAspectRatio="xMidYMid meet">
        {[
          { c:'#7118C2', s:32 }, { c:'#150352', s:26 }, { c:'#BC10DE', s:20 },
          { c:'#7118C2', s:14 }, { c:'#00FB90', s:8  }, { c:'#150352', s:4  }
        ].map((r, i) => {
          const inset = i * 5;
          const pts = [
            [25+inset*0.5, inset], [75-inset*0.5, inset],
            [100-inset, 43.3], [75-inset*0.5, 86.6-inset],
            [25+inset*0.5, 86.6-inset], [inset, 43.3]
          ].map(p => p.join(',')).join(' ');
          return <polygon points={pts} fill="none" stroke={r.c} stroke-width={r.s} stroke-linejoin="round" />;
        })}
      </svg>
    </div>
    <div class="hero-blob b2" aria-hidden="true">
      <svg viewBox="-14 -14 128 114" width="90" height="78">
        <polygon points="25,0 75,0 100,43.3 75,86.6 25,86.6 0,43.3" fill="#BC10DE" stroke="#BC10DE" stroke-width="22" stroke-linejoin="round" />
      </svg>
    </div>
    <div class="container hero-grid">
      <div>
        <div class="hero-eyebrow">{hero.eyebrow}</div>
        <h1 class="hero-title" set:html={hero.titleHtml} />
        <p class="hero-sub">
          {hero.sub}
        </p>
        <div class="hero-ctas">
          <a class="btn btn-lg btn-mint" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
            <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
          </a>
          <a class="btn btn-lg btn-ghost-dark" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
        </div>
      </div>
      <div class="hero-portrait about-hero-portrait">
        <img
          class="about-hero-img"
          src={hero.image.src}
          alt={hero.image.alt}
          width="660"
          height="auto"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Short version band -->
  <section class="about-short">
    <div class="container about-short-grid reveal">
      <div class="eyebrow">{shortVersion.eyebrow}</div>
      <p class="about-short-lead" set:html={shortVersion.leadHtml} />
    </div>
  </section>

  <!-- Mission / convictions -->
  <section class="about-mission">
    <div class="container">
      <div class="section-head about-mission-head reveal">
        <div class="eyebrow">{mission.eyebrow}</div>
        <h2 set:html={mission.headingHtml} />
      </div>
      <div class="conviction-grid">
        {mission.convictions.map((c, i) => (
          <article class="conviction-card reveal" style={`--cv-accent:${c.color};--reveal-delay:${i*85}ms`}>
            <div class="conviction-num">
              <img class="conviction-icon" src={c.icon} alt="" width="56" height="56" loading="lazy" />
            </div>
            <h3 class="conviction-title">{c.title}</h3>
            <p class="conviction-body">{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Team / founders -->
  <section class="about-team">
    <div class="container">
      <div class="section-head about-team-head reveal">
        <div class="eyebrow">{team.eyebrow}</div>
        <h2 set:html={team.headingHtml} />
        <p class="about-team-intro" set:html={team.introHtml} />
      </div>
      <div class="founder-list">
        {team.founders.map((p, i) => (
          <article class="founder-card reveal" style={`--reveal-delay:${i*90}ms`}>
            <div class="founder-photo-wrap">
              <img
                class="founder-photo"
                src={p.photo}
                alt={p.name}
                width="280"
                height="320"
                loading="lazy"
              />
            </div>
            <div class="founder-body">
              <div class="founder-title">{p.title}</div>
              <h3 class="founder-name">{p.name}</h3>
              {p.bio.map(para => <p class="founder-bio">{para}</p>)}
              <div class="founder-firms">
                <span class="founder-firms-label">Experience</span>
                <div class="founder-firms-chips">
                  {p.firms.map(f => <span class="firm-chip">{f}</span>)}
                </div>
              </div>
              <div class="founder-industries">{p.industries}</div>
              <a class="leader-link founder-link" href={p.linkedin} target="_blank" rel="noopener noreferrer">
                Connect on LinkedIn <span class="ar">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="about-story" id="story">
    <div class="container story-layout">
      <div class="story-col-left reveal">
        <div class="eyebrow story-eyebrow">{story.eyebrow}</div>
        <h2 class="story-headline" set:html={story.headingHtml} />
        <blockquote class="hume-quote">
          <p>"{story.quote.text}"</p>
          <cite set:html={story.quote.citeHtml} />
        </blockquote>
        <div class="story-photo">
          <img
            class="story-img"
            src={story.image.src}
            alt={story.image.alt}
            width="520"
            height="400"
            loading="lazy"
          />
        </div>
      </div>
      <div class="story-col-right reveal">
        {story.paragraphs.map(para => <p class="story-para">{para}</p>)}
        <p class="story-para story-sign-line" set:html={story.signOffHtml} />
        <p class="story-para" set:html={story.closingParagraphHtml} />
        <div class="story-signature">{story.signature}</div>
      </div>
    </div>
  </section>

  <CTAForm
    id={cta.id}
    formId={cta.formId}
    eyebrow={cta.eyebrow}
    heading={cta.headingHtml}
    subtitle={cta.subtitle}
  />

  <Footer />
  <ScrollReveal />
</BaseLayout>
