---
import { getEntry } from 'astro:content';
import type { ContactData } from '../content.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/contact.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const contact = await getEntry('pages', 'contact');
const { meta, hero, expect: expectItems, directContacts, expectHeading, directHeading } = contact!.data as ContactData;

const stages = ['Just exploring', 'Pilots underway', 'Scaling', 'Stuck'];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
>
  <Nav current="/contact" />

  <!-- Hero -->
  <section class="contact-hero">
    <div class="hero-blob b1" aria-hidden="true">
      <svg viewBox="-20 -20 140 120" width="300" height="260" preserveAspectRatio="xMidYMid meet">
        {[
          { c:'#7118C2', s:32 }, { c:'#150352', s:26 }, { c:'#BC10DE', s:20 },
          { c:'#7118C2', s:14 }, { c:'#00FB90', s:8  }, { c:'#150352', s:4  }
        ].map((r, i) => {
          const inset = i * 5;
          const pts = [
            [25+inset*0.5, inset], [75-inset*0.5, inset],
            [100-inset, 43.3], [75-inset*0.5, 86.6-inset],
            [25+inset*0.5, 86.6-inset], [inset, 43.3]
          ].map(p => p.join(',')).join(' ');
          return <polygon points={pts} fill="none" stroke={r.c} stroke-width={r.s} stroke-linejoin="round" />;
        })}
      </svg>
    </div>
    <div class="hero-blob b2" aria-hidden="true">
      <svg viewBox="-14 -14 128 114" width="84" height="73">
        <polygon points="25,0 75,0 100,43.3 75,86.6 25,86.6 0,43.3" fill="#BC10DE" stroke="#BC10DE" stroke-width="22" stroke-linejoin="round" />
      </svg>
    </div>
    <div class="container contact-hero-inner">
      <div class="hero-eyebrow">{hero.eyebrow}</div>
      <h1 class="contact-title" set:html={hero.titleHtml} />
      <p class="contact-intro" set:html={hero.introHtml} />
    </div>
  </section>

  <!-- Main grid: form + sidebar -->
  <section class="contact-main">
    <div class="container contact-grid">

      <!-- Form -->
      <form class="form-card contact-form reveal" id="contact-form" novalidate>
        <div class="form-row split">
          <div>
            <label for="cf-fname">First name</label>
            <input id="cf-fname" type="text" name="firstName" placeholder="Alex" autocomplete="given-name" />
          </div>
          <div>
            <label for="cf-lname">Last name</label>
            <input id="cf-lname" type="text" name="lastName" placeholder="Morgan" autocomplete="family-name" />
          </div>
        </div>
        <div class="form-row split">
          <div>
            <label for="cf-email">Work email</label>
            <input id="cf-email" type="email" name="email" placeholder="you@company.com" autocomplete="email" />
          </div>
          <div>
            <label for="cf-company">Company</label>
            <input id="cf-company" type="text" name="company" placeholder="Organization" autocomplete="organization" />
          </div>
        </div>
        <div class="form-row">
          <label>Where are you in your AI journey?</label>
          <div class="form-options" role="group" aria-label="AI journey stage">
            {stages.map((s, i) => (
              <button type="button" class={`opt${i === 1 ? ' active' : ''}`} data-stage={s}>{s}</button>
            ))}
          </div>
          <input type="hidden" name="stage" value="Pilots underway" />
        </div>
        <div class="form-row">
          <label for="cf-msg">Tell us about your organization</label>
          <textarea id="cf-msg" name="message" placeholder="Where your AI program stands, what's getting in your way, and where you want to go…"></textarea>
        </div>
        <div class="form-error" id="cf-error" hidden></div>
        <div class="form-actions">
          <div class="fineprint">A member of the executive team will be in touch within 1–2 business days. We won't share your details.</div>
          <button type="submit" class="btn btn-lg btn-mint">
            Send
            <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
          </button>
        </div>
        <div id="cf-success" hidden style="padding:20px 0;color:var(--he-purple);font-weight:600;font-family:var(--font-display);text-align:center">
          ✓ Message received. A founding partner will be in touch within 1–2 business days.
        </div>
      </form>

      <!-- Sidebar -->
      <aside class="contact-side reveal">
        <div class="expect-block">
          <h2 class="contact-side-head">{expectHeading}</h2>
          <ol class="expect-list">
            {expectItems.map(e => (
              <li class="expect-item">
                <span class="expect-num">{e.n}</span>
                <div class="expect-text">
                  <div class="expect-title">{e.title}</div>
                  <p class="expect-body">{e.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="direct-block">
          <h2 class="contact-side-head">{directHeading}</h2>
          <div class="direct-list">
            {directContacts.map(c => (
              <a class="direct-item" href={`mailto:${c.email}`}>
                <span class="direct-link">{c.label} <span class="ar">→</span></span>
              </a>
            ))}
          </div>
        </div>
      </aside>

    </div>
  </section>

  <Footer />
  <ScrollReveal />
</BaseLayout>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement;
  const errEl   = document.getElementById('cf-error')!;
  const success = document.getElementById('cf-success')!;
  const stageInput = form.querySelector('input[name=stage]') as HTMLInputElement;

  form.querySelectorAll('.opt').forEach(btn => {
    btn.addEventListener('click', () => {
      form.querySelectorAll('.opt').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      stageInput.value = (btn as HTMLElement).dataset.stage || '';
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((payload.email as string)?.trim());

    if (!payload.firstName || !payload.lastName || !emailOk || !payload.company) {
      errEl.textContent = 'Please fill in all required fields with a valid work email.';
      errEl.removeAttribute('hidden');
      return;
    }
    errEl.setAttribute('hidden', '');

    const submitBtn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Server error');
      form.querySelectorAll('input, textarea, button, .form-options').forEach(el => {
        (el as HTMLElement).style.display = 'none';
      });
      form.querySelector('.form-actions')!.setAttribute('hidden', '');
      success.removeAttribute('hidden');
    } catch {
      errEl.textContent = 'Something went wrong. Please try again or email us directly at connect@humeedge.ai.';
      errEl.removeAttribute('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send';
    }
  });
</script>
