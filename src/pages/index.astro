---
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';
import BaseLayout from '../layouts/BaseLayout.astro';
// No page-specific styles needed - all base styles loaded via layout
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import ProblemCarousel from '../components/ProblemCarousel.astro';
import ImageBreak from '../components/ImageBreak.astro';
import ServicesSection from '../components/ServicesSection.astro';
// import ResourceDownload from '../components/ResourceDownload.astro'; // hidden until PDF is provided
import VersusSplit from '../components/VersusSplit.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import WhyDifferent from '../components/WhyDifferent.astro';
import LeadershipTeam from '../components/LeadershipTeam.astro';
import Testimonials from '../components/Testimonials.astro';
import CTAForm from '../components/CTAForm.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const home = await getEntry('pages', 'home');
const { meta, orgSchema, cta } = home!.data as HomeData;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  schema={orgSchema}
>
  <Nav current="/" />
  <Hero />
  <Intro />
  <ProblemCarousel />
  <ImageBreak />
  <ServicesSection />
  {/* <ResourceDownload /> */}
  <VersusSplit />
  <IndustriesSection />
  <Testimonials />
  <WhyDifferent />
  <LeadershipTeam />
  <CTAForm id="contact" formId="home-cta" eyebrow={cta.eyebrow} heading={cta.headingHtml} subtitle={cta.subtitle} />
  <Footer />
  <ScrollReveal />
</BaseLayout>
