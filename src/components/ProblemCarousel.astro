---
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';
import Editable from './Editable.astro';

const home = await getEntry('pages', 'home');
const { problems } = home!.data as HomeData;
const file = 'src/content/pages/home.json';
---

<section class="problem" data-k-module-file={file} data-k-module-path="problems" data-k-module-label="Problems">
  <div class="container">
    <div class="section-head reveal">
      <Editable as="div" class="eyebrow" kind="text" value={problems.eyebrow} file={file} path="problems.eyebrow" label="Problems eyebrow" />
      <Editable as="h2" kind="html" value={problems.headingHtml} file={file} path="problems.headingHtml" label="Problems heading" />
      <Editable as="p" kind="text" value={problems.intro} file={file} path="problems.intro" label="Problems intro" />
    </div>
  </div>

  <div class="problem-track-wrap">
    <div class="problem-track" id="problem-track">
      {problems.items.map((p, i) => (
        <article
          class="problem-card reveal"
          style={`--card-accent:${p.color}`}
          data-k-module-file={file}
          data-k-module-path={`problems.items.${i}`}
          data-k-module-label={`Problem card ${i + 1}`}
        >
          <div class="head">
            <img class="problem-icon" src={p.icon} alt="" width="60" height="60" loading="lazy" />
          </div>
          <h3
            class="quote"
            data-k-file={file}
            data-k-path={`problems.items.${i}.quote`}
            data-k-value={p.quote}
            data-k-kind="text"
            data-k-label="Problem quote"
          >{p.quote}</h3>
          <p
            class="body"
            data-k-file={file}
            data-k-path={`problems.items.${i}.body`}
            data-k-value={p.body}
            data-k-kind="text"
            data-k-label="Problem body"
          >{p.body}</p>
        </article>
      ))}
      <div style="flex:0 0 56px" aria-hidden="true"></div>
    </div>
    <div class="problem-arrow-row">
      <button class="problem-arrow problem-arrow--prev" id="prob-prev" aria-label="Previous">‹</button>
      <button class="problem-arrow problem-arrow--next" id="prob-next" aria-label="Next">›</button>
    </div>
  </div>

  <div class="container problem-controls">
    <div class="progress" role="progressbar" aria-label="Carousel progress">
      <div class="bar" id="prob-bar" style="width:20%"></div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('problem-track')!;
  const bar   = document.getElementById('prob-bar')!;
  const prev  = document.getElementById('prob-prev')!;
  const next  = document.getElementById('prob-next')!;

  function updateBar() {
    const max = track.scrollWidth - track.clientWidth;
    const pct = max > 0 ? (track.scrollLeft / max) * 100 : 0;
    bar.style.width = `${Math.max(20, pct)}%`;
  }

  track.addEventListener('scroll', updateBar, { passive: true });
  prev.addEventListener('click', () => track.scrollBy({ left: -402, behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  402, behavior: 'smooth' }));
</script>
