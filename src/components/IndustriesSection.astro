---

<section class="industries" id="industries">
  <div class="container ind-wrap">
    <div class="ind-left">
      <div class="eyebrow ind-eyebrow">{industries.eyebrow}</div>
      <h2 class="ind-title" set:html={industries.titleHtml} />
      <div class="ind-active" id="ind-active-name">{industries.items[0].name}</div>
      <p class="ind-body ind-body--desktop">
        {industries.body}
      </p>
    </div>

    <div class="ind-list-wrap">
      <p class="ind-body ind-body--mobile">
        {industries.body}
      </p>
      <ul class="ind-list">
        {industries.items.map((it, i) => (
          <li class="ind-list-item">
            <button
              type="button"
              class={`ind-card${i === 0 ? ' is-active' : ''}`}
              data-ind-index={i}
              data-ind-name={it.name}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="ind-card-icon">
                <svg class="ind-hex" viewBox="0 0 446.36 495.36" aria-hidden="true">
                  <path fill={HEX_COLORS[i % 4]} d="M0,156.25v182.86c0,23.16,12.36,44.56,32.41,56.14l158.36,91.43c20.06,11.58,44.77,11.58,64.82,0l158.36-91.43c20.06-11.58,32.41-32.98,32.41-56.14v-182.86c0-23.16-12.36-44.56-32.41-56.14L255.59,8.68c-20.06-11.58-44.77-11.58-64.82,0L32.41,100.11C12.36,111.69,0,133.09,0,156.25Z" />
                </svg>
                <span class="ind-card-glyph">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON_PATHS[it.icon]} />
                </span>
              </span>
              <span class="ind-card-name">{it.name}</span>
              <span class="ind-card-chev">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <div class="ind-list-fade" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  const activeNameEl = document.getElementById('ind-active-name')!;
  const cards = document.querySelectorAll<HTMLButtonElement>('.ind-card');
  let currentActive = 0;

  function setActive(index: number, animate = true) {
    if (index === currentActive && animate) return;
    currentActive = index;
    const name = cards[index]?.dataset.indName ?? '';
    if (animate && activeNameEl.textContent !== name) {
      activeNameEl.classList.remove('ind-active-anim');
      void (activeNameEl as HTMLElement).offsetWidth;
      activeNameEl.classList.add('ind-active-anim');
    }
    activeNameEl.textContent = name;
    cards.forEach((c, i) => {
      c.classList.toggle('is-active', i === index);
      if (i === index) c.setAttribute('aria-current', 'true');
      else c.removeAttribute('aria-current');
    });
  }

  // Scroll-driven: highlight card whose centre is closest to the focal point.
  // On mobile the ind-left header is sticky, so the visible list area starts
  // below it — we use its bottom edge as the top of the focal zone.
  const indLeft = document.querySelector<HTMLElement>('.ind-left');

  function getFocal(): number {
    if (indLeft && getComputedStyle(indLeft).position === 'sticky') {
      const headerBottom = indLeft.getBoundingClientRect().bottom;
      return headerBottom + (window.innerHeight - headerBottom) / 2;
    }
    return window.innerHeight / 2;
  }

  let raf: number | null = null;
  function onScroll() {
    if (raf != null) return;
    raf = requestAnimationFrame(() => {
      raf = null;
      const focal = getFocal();
      let best = 0, bestDist = Infinity;
      cards.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - focal);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      setActive(best);
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  cards.forEach((c, i) => {
    c.addEventListener('click', () => setActive(i));
    c.addEventListener('focus', () => setActive(i));
  });

  // Hide the bottom fade once the last card is fully in view
  const fadeEl = document.querySelector<HTMLElement>('.ind-list-fade');
  const lastCard = cards[cards.length - 1];
  if (fadeEl && lastCard) {
    const obs = new IntersectionObserver(([entry]) => {
      fadeEl.style.opacity = entry.isIntersecting ? '0' : '1';
    }, { threshold: 0.9 });
    obs.observe(lastCard);
  }
</script>
