---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import logoWhite from '../assets/hume-edge-logo-white.png';

const site = await getEntry('site', 'global');
const { footer } = site!.data;
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <a href="/" aria-label="Hume Edge home" style="display:inline-block;line-height:0">
            <Image class="footer-logo-lockup" src={logoWhite} alt="Hume Edge" width={238} />
          </a>
        </div>
        <p>{footer.tagline}</p>
      </div>
      <div class="footer-nav">
        {footer.nav.map((link, i) => [
          <a class="footer-nav-link" href={link.href}>{link.label}</a>,
          i < footer.nav.length - 1 ? ' ' : null,
        ])}
        <a class="btn btn-mint" href={footer.ctaHref}>{footer.ctaLabel}</a>
      </div>
    </div>
    <div class="footer-legal">
      <span>{footer.legal}</span>
    </div>
  </div>
</footer>
