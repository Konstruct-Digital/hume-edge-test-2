---
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';
import Editable from './Editable.astro';
import { plain } from '../lib/plain';

const home = await getEntry('pages', 'home');
const { leadership } = home!.data as HomeData;
const file = 'src/content/pages/home.json';
---

<section class="leadership" data-k-module-file={file} data-k-module-path="leadership" data-k-module-label="Leadership">
  <div class="container">
    <div class="section-head leadership-head reveal">
      <Editable as="div" class="eyebrow" style="justify-content:center" kind="text" value={leadership.eyebrow} file={file} path="leadership.eyebrow" label="Leadership eyebrow" />
      <Editable as="h2" kind="text" value={leadership.heading} file={file} path="leadership.heading" label="Leadership heading" />
    </div>
    <div class="leaders-grid" id="leaders-grid">
      {leadership.leaders.map((p, i) => (
        <div
          class="leader-card reveal"
          style={`--reveal-delay:${i*85}ms`}
          role="button"
          tabindex="0"
          aria-label={`${plain(p.name)} - click to see bio`}
          data-leader
          data-k-module-file={file}
          data-k-module-path={`leadership.leaders.${i}`}
          data-k-module-label={`Leader ${i + 1}`}
        >
          <div class="leader-flip">
            <div class="leader-face leader-front">
              <img class="leader-photo" src={p.photo} alt={plain(p.name)} width="150" height="150" loading="lazy" />
              <Editable as="h3" class="leader-name" file={file} path={`leadership.leaders.${i}.name`} value={p.name} label="Leader name" />
              <Editable as="div" class="leader-title" file={file} path={`leadership.leaders.${i}.title`} value={p.title} label="Leader title" />
              <a
                class="leader-link"
                href={p.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                data-k-file={file}
                data-k-href-path={`leadership.leaders.${i}.linkedin`}
                data-k-href-value={p.linkedin}
              >
                Connect on LinkedIn <span class="ar">↗</span>
              </a>
            </div>
            <div class="leader-face leader-back">
              <Editable as="h3" class="leader-name" file={file} path={`leadership.leaders.${i}.name`} value={p.name} label="Leader name" />
              <Editable as="div" class="leader-title" file={file} path={`leadership.leaders.${i}.title`} value={p.title} label="Leader title" />
              <Editable as="p" class="leader-bio" file={file} path={`leadership.leaders.${i}.bio`} value={p.bio} label="Leader bio" />
              <a
                class="leader-link"
                href={p.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                data-k-file={file}
                data-k-href-path={`leadership.leaders.${i}.linkedin`}
                data-k-href-value={p.linkedin}
              >
                Connect on LinkedIn <span class="ar">↗</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="leaders-arrows">
      <button class="leaders-arrow leaders-arrow--prev" id="leaders-prev" aria-label="Previous leader">‹</button>
      <button class="leaders-arrow leaders-arrow--next" id="leaders-next" aria-label="Next leader">›</button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-leader]').forEach(card => {
    const toggle = () => card.classList.toggle('is-flipped');
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', (e: Event) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') { ke.preventDefault(); toggle(); }
    });
  });

  const grid = document.getElementById('leaders-grid')!;
  const prev = document.getElementById('leaders-prev');
  const next = document.getElementById('leaders-next');
  if (prev && next) {
    prev.addEventListener('click', () => grid.scrollBy({ left: -grid.clientWidth * 0.8, behavior: 'smooth' }));
    next.addEventListener('click', () => grid.scrollBy({ left:  grid.clientWidth * 0.8, behavior: 'smooth' }));
  }
</script>
