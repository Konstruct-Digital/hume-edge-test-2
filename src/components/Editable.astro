---
// src/components/Editable.astro
// Wraps a single content-JSON-sourced value with the data-k-* markup
// contract the injected inline-edit script (public/kc-inline-edit.js) looks
// for — see EDITABLE-CONTRACT.md for the full contract. Renders the leaf
// element itself (Astro's dynamic-tag support) rather than wrapping an
// already-rendered child, so adopting it in an existing render branch is a
// one-line swap with zero markup-shape change: `<h1>{x}</h1>` becomes
// `<Editable as="h1" value={x} file="..." path="..." />`.
interface Props {
	as: string;
	value: string;
	file: string;
	path: string;
	kind?: 'text' | 'html';
	label?: string;
	hrefPath?: string;
	hrefValue?: string;
	href?: string;
	class?: string;
	style?: string;
}
const { as: Tag, value, file, path, kind = 'text', label, hrefPath, hrefValue, href, class: className, style } = Astro.props;
---

{kind === 'html' ? (
	<Tag
		data-k-file={file}
		data-k-path={path}
		data-k-value={value}
		data-k-kind={kind}
		data-k-label={label}
		data-k-href-path={hrefPath}
		data-k-href-value={hrefValue}
		// @ts-expect-error - Astro dynamic-tag limitation: `class` isn't resolvable against IntrinsicAttributes for a tag typed as a plain string (const Tag = as). Confirmed load-bearing (real leaf fields with a class/style exist on real sites), not avoidable by dropping the prop.
		class={className}
		style={style}
		href={href}
		set:html={value}
	/>
) : (
	<Tag
		data-k-file={file}
		data-k-path={path}
		data-k-value={value}
		data-k-kind={kind}
		data-k-label={label}
		data-k-href-path={hrefPath}
		data-k-href-value={hrefValue}
		// @ts-expect-error - Astro dynamic-tag limitation: `class` isn't resolvable against IntrinsicAttributes for a tag typed as a plain string (const Tag = as). Confirmed load-bearing (real leaf fields with a class/style exist on real sites), not avoidable by dropping the prop.
		class={className}
		style={style}
		href={href}
	>{value}</Tag>
)}
