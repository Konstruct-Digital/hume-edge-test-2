---
// src/components/Editable.astro
// Wraps a single content-JSON-sourced value with the data-k-* markup
// contract the injected inline-edit script (public/kc-inline-edit.js) looks
// for — see EDITABLE-CONTRACT.md for the full contract. Renders the leaf
// element itself (Astro's dynamic-tag support) rather than wrapping an
// already-rendered child, so adopting it in an existing render branch is a
// one-line swap with zero markup-shape change: `<h1>{x}</h1>` becomes
// `<Editable as="h1" value={x} file="..." path="..." />`.
interface Props {
	as: string;
	// A field whose formatting might need to change later (see
	// EDITABLE-CONTRACT.md's "Variable-kind fields") is stored as
	// { text, kind } instead of a bare string — detected automatically
	// below, so the common case (a plain string, kind fixed by the kind
	// prop) needs zero extra ceremony.
	value: string | { text: string; kind: 'text' | 'html' };
	file: string;
	path: string;
	kind?: 'text' | 'html';
	label?: string;
	hrefPath?: string;
	hrefValue?: string;
	href?: string;
	class?: string;
	style?: string;
}
const { as: Tag, value: rawValue, file, path, kind: kindProp = 'text', label, hrefPath, hrefValue, href, class: className, style } = Astro.props;
const isVariableKind = rawValue !== null && typeof rawValue === 'object';
const value = isVariableKind ? rawValue.text : rawValue;
const kind = isVariableKind ? rawValue.kind : kindProp;
// Only present for a variable-kind field — this is the path a future
// "Add styling" edit would target to flip kind in place, the exact same
// way any other content edit already works (setByPath on an existing
// string field). Astro omits an attribute entirely when its value is
// undefined, same as data-k-label/data-k-href-path already rely on.
const valuePath = isVariableKind ? `${path}.text` : path;
const kindPath = isVariableKind ? `${path}.kind` : undefined;
// Astro dynamic-tag limitation: `class`/`style` aren't resolvable against
// IntrinsicAttributes for a tag typed as a plain string (const Tag = as).
// Casting the tag reference to `any` (rather than `@ts-expect-error`-ing the
// `class` attribute line) sidesteps the type error without relying on an
// inline comment inside a tag's attribute list — Astro's markup compiler
// does not treat `//` or `{/* */}` there as an ignorable comment the way a
// real TSX parser would, so either form leaks into (or breaks) the
// compiled output. This is confirmed load-bearing: real leaf fields with a
// class/style exist on real sites, so the prop can't just be dropped.
const DynamicTag = Tag as any;
---

{kind === 'html' ? (
	<DynamicTag
		data-k-file={file}
		data-k-path={valuePath}
		data-k-value={value}
		data-k-kind={kind}
		data-k-kind-path={kindPath}
		data-k-label={label}
		data-k-href-path={hrefPath}
		data-k-href-value={hrefValue}
		class={className}
		style={style}
		href={href}
		set:html={value}
	/>
) : (
	<DynamicTag
		data-k-file={file}
		data-k-path={valuePath}
		data-k-value={value}
		data-k-kind={kind}
		data-k-kind-path={kindPath}
		data-k-label={label}
		data-k-href-path={hrefPath}
		data-k-href-value={hrefValue}
		class={className}
		style={style}
		href={href}
	>{value}</DynamicTag>
)}
