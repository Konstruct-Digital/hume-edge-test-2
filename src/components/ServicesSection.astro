---
import { getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
const { services } = home!.data;
---

<section class="services" id="services">
  <div class="container">
    <div class="services-head">
      <div class="section-head reveal" style="margin-bottom:0">
        <div class="eyebrow">{services.eyebrow}</div>
        <h2 set:html={services.headingHtml} />
      </div>
      <div class="right reveal">
        {services.rightParagraphs.map((p, i) => (
          <p style={i === 0 ? 'margin-bottom:16px' : undefined}>{p}</p>
        ))}
      </div>
    </div>

    <div class="services-grid">
      {services.items.map((s, i) => (
        <article class="service-card reveal" style={`--card-accent:${s.accent};--card-ink:${s.ink};--reveal-delay:${i*85}ms`}>
          <div class="card-face">
            <div class="top">
              <img class="service-icon" src={s.icon} alt="" width="64" height="64" loading="lazy" />
            </div>
            <h3 class="title">{s.title}</h3>
            <p class="body">{s.blurb}</p>
            <button
              type="button"
              class="cta"
              data-svc-index={i}
              aria-haspopup="dialog"
            >
              Explore
              <svg class="ar" viewBox="0 0 36 30" fill="none" aria-hidden="true" width="14" height="11"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
            </button>
          </div>
        </article>
      ))}
    </div>

    <!-- Lab / Studio card -->
    <article class="studio-card reveal" id="lab-card">
      <img class="studio-icon" src={services.lab.icon} alt="Hume Edge Lab" width="120" height="120" loading="lazy" />
      <div class="studio-body" id="lab-body">
        <div class="label">{services.lab.label}</div>
        <div id="lab-default">
          <h3 class="title">{services.lab.defaultTitle}</h3>
          <p class="body">{services.lab.defaultBody}</p>
        </div>
        <div id="lab-expanded" hidden>
          <h3 class="title">{services.lab.expandedTitle}</h3>
          <ul class="deliverables">
            {services.lab.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      </div>
      <button type="button" class="btn btn-lg btn-mint" id="lab-toggle">
        Explore
        <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
      </button>
    </article>
  </div>

  <!-- Service modal: unchanged markup -->
  <style>.svc-modal-overlay[hidden] { display: none !important; }</style>
  <div class="svc-modal-overlay" id="svc-overlay" hidden aria-modal="true" role="dialog" aria-label="Service details">
    <div class="svc-modal" id="svc-modal">
      <button type="button" class="svc-modal-close" id="svc-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <div class="svc-modal-head">
        <img class="svc-modal-icon" id="svc-icon" src="" alt="" width="56" height="56" />
        <h3 class="svc-modal-title" id="svc-title"></h3>
      </div>
      <div class="svc-modal-tagline" id="svc-tagline"></div>
      <p class="svc-modal-intro" id="svc-intro"></p>
      <div class="svc-modal-deliverables-label">What we deliver</div>
      <ul class="svc-modal-deliverables" id="svc-bullets"></ul>
    </div>
  </div>
</section>

<script define:vars={{ servicesData: services.items }}>
  const SERVICES_DATA = servicesData;

  const overlay  = document.getElementById('svc-overlay');
  const modal    = document.getElementById('svc-modal');
  const closeBtn = document.getElementById('svc-close');

  function openModal(i) {
    const s = SERVICES_DATA[i];
    modal.style.setProperty('--card-accent', s.accent);
    modal.style.setProperty('--card-ink', s.ink);
    document.getElementById('svc-icon').src = s.icon;
    document.getElementById('svc-title').textContent = s.title;
    document.getElementById('svc-tagline').textContent = s.tagline;
    document.getElementById('svc-intro').textContent = s.intro;
    const ul = document.getElementById('svc-bullets');
    ul.innerHTML = s.bullets.map(b => `<li>${b}</li>`).join('');
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-svc-index]').forEach(btn => {
    btn.addEventListener('click', () => openModal(Number(btn.dataset.svcIndex)));
  });

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // Lab card toggle
  const labToggle   = document.getElementById('lab-toggle');
  const labDefault  = document.getElementById('lab-default');
  const labExpanded = document.getElementById('lab-expanded');
  let labOpen = false;

  labToggle.addEventListener('click', () => {
    labOpen = !labOpen;
    labDefault.hidden  = labOpen;
    labExpanded.hidden = !labOpen;
    labToggle.innerHTML = labOpen
      ? `<svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true" style="transform:scaleX(-1)"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg> Back`
      : `Explore <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>`;
  });
</script>
