---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';
import introPhoto from '../assets/images/intro-photo.png';
import Editable from './Editable.astro';

const home = await getEntry('pages', 'home');
const { intro } = home!.data as HomeData;
const file = 'src/content/pages/home.json';
---
<section class="intro" data-k-module-file={file} data-k-module-path="intro" data-k-module-label="Intro">
  <div class="container intro-grid">
    <div class="intro-art">
      <div class="photo-frame" style="aspect-ratio:4/5">
        <Image
          class="photo-frame-img"
          src={introPhoto}
          alt="Hume Edge team working session"
          widths={[330, 460]}
          sizes="(max-width: 660px) 100vw, 460px"
          quality={70}
          loading="lazy"
          style="object-fit:contain"
        />
      </div>
      <div class="intro-art-sticker" aria-hidden="true">
        <svg viewBox="-14 -14 128 114" width="84" height="73" preserveAspectRatio="xMidYMid meet">
          <polygon points="25,0 75,0 100,43.3 75,86.6 25,86.6 0,43.3" fill="#00FB90" stroke="#00FB90" stroke-width="22" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <div class="intro-body">
      <Editable as="div" class="eyebrow" kind="text" value={intro.eyebrow} file={file} path="intro.eyebrow" label="Intro eyebrow" />
      <Editable as="p" class="lead" style="margin-top:24px" kind="html" value={intro.leadHtml} file={file} path="intro.leadHtml" label="Intro lead" />
      {intro.paragraphs.map((p, i) => (
        <p
          class="body"
          set:html={p}
          data-k-file={file}
          data-k-path={`intro.paragraphs.${i}`}
          data-k-value={p}
          data-k-kind="html"
          data-k-label={`Intro paragraph ${i + 1}`}
        />
      ))}
      <Editable as="p" class="intro-tagline" kind="html" value={intro.taglineHtml} file={file} path="intro.taglineHtml" label="Intro tagline" />
      <Editable
        as="a"
        class="btn btn-ghost-dark"
        kind="text"
        value={intro.ctaLabel}
        file={file}
        path="intro.ctaLabel"
        hrefPath="intro.ctaHref"
        hrefValue={intro.ctaHref}
        href={intro.ctaHref}
        label="Intro CTA label"
      />
    </div>
  </div>
</section>
