---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import introPhoto from '../assets/images/intro-photo.png';

const home = await getEntry('pages', 'home');
const { intro } = home!.data;
---
<section class="intro">
  <div class="container intro-grid">
    <div class="intro-art">
      <div class="photo-frame" style="aspect-ratio:4/5">
        <Image
          class="photo-frame-img"
          src={introPhoto}
          alt="Hume Edge team working session"
          widths={[330, 460]}
          sizes="(max-width: 660px) 100vw, 460px"
          quality={70}
          loading="lazy"
          style="object-fit:contain"
        />
      </div>
      <div class="intro-art-sticker" aria-hidden="true">
        <svg viewBox="-14 -14 128 114" width="84" height="73" preserveAspectRatio="xMidYMid meet">
          <polygon points="25,0 75,0 100,43.3 75,86.6 25,86.6 0,43.3" fill="#00FB90" stroke="#00FB90" stroke-width="22" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <div class="intro-body">
      <div class="eyebrow">{intro.eyebrow}</div>
      <p class="lead" style="margin-top:24px" set:html={intro.leadHtml} />
      {intro.paragraphs.map((p, i) => <>
        {i > 0 && ' '}<p class="body" set:html={p} /></>
      )}
      <p class="intro-tagline" set:html={intro.taglineHtml} />
      <a class="btn btn-ghost-dark" href={intro.ctaHref}>{intro.ctaLabel}</a>
    </div>
  </div>
</section>
