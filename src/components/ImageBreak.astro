---
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';

const home = await getEntry('pages', 'home');
const { imageBreak } = home!.data as HomeData;
---
<section class="imgbreak">
  <div class="container imgbreak-grid">
    <div class="imgbreak-photo reveal">
      <video
        class="imgbreak-photo-img"
        src="/assets/video/imgbreak-video.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        aria-label="A Hume Edge consultant at work"
      ></video>
    </div>
    <div class="imgbreak-content">
      <h2 class="imgbreak-lead" set:html={imageBreak.headlineHtml} />
      <div class="imgbreak-cta">
        <a class="btn btn-lg btn-mint" href={imageBreak.ctaHref}>
          {imageBreak.ctaLabel}
          <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
        </a>
      </div>
      <div class="stat-pair">
        {imageBreak.stats.map(s => (
          <div class="stat-row">
            <div class="big">{s.value}<span class="pct">{s.suffix}</span></div>
            <div class="lead">
              {s.text}
              <span class="src">{s.source}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
