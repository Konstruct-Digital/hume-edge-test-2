---
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';
import Editable from './Editable.astro';

const home = await getEntry('pages', 'home');
const { imageBreak } = home!.data as HomeData;
const file = 'src/content/pages/home.json';
---
<section class="imgbreak" data-k-module-file={file} data-k-module-path="imageBreak" data-k-module-label="Image break">
  <div class="container imgbreak-grid">
    <div class="imgbreak-photo reveal">
      <video
        class="imgbreak-photo-img"
        src="/assets/video/imgbreak-video.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        aria-label="A Hume Edge consultant at work"
      ></video>
    </div>
    <div class="imgbreak-content">
      <Editable as="h2" class="imgbreak-lead" kind="html" value={imageBreak.headlineHtml} file={file} path="imageBreak.headlineHtml" label="Image break headline" />
      <div class="imgbreak-cta">
        <a
          class="btn btn-lg btn-mint"
          href={imageBreak.ctaHref}
          data-k-file={file}
          data-k-path="imageBreak.ctaLabel"
          data-k-value={imageBreak.ctaLabel}
          data-k-kind="text"
          data-k-label="Image break CTA label"
          data-k-href-path="imageBreak.ctaHref"
          data-k-href-value={imageBreak.ctaHref}
        >
          {imageBreak.ctaLabel}
          <svg class="btn-arrow" viewBox="0 0 36 30" fill="none" aria-hidden="true"><path d="M35.4142 16.1421C36.1953 15.3611 36.1953 14.0947 35.4142 13.3137L22.6863 0.58577C21.9052 -0.195279 20.6389 -0.195279 19.8579 0.58577C19.0768 1.36682 19.0768 2.63315 19.8579 3.4142L31.1716 14.7279L19.8579 26.0416C19.0768 26.8227 19.0768 28.089 19.8579 28.87C20.6389 29.6511 21.9052 29.6511 22.6863 28.87L35.4142 16.1421ZM0 14.7279V16.7279H34V14.7279V12.7279H0V14.7279Z" fill="currentColor"/></svg>
        </a>
      </div>
      <div class="stat-pair">
        {imageBreak.stats.map((s, i) => (
          <div
            class="stat-row"
            data-k-module-file={file}
            data-k-module-path={`imageBreak.stats.${i}`}
            data-k-module-label={`Stat ${i + 1}`}
          >
            <div
              class="big"
              data-k-file={file}
              data-k-path={`imageBreak.stats.${i}.value`}
              data-k-value={s.value}
              data-k-kind="text"
              data-k-label="Stat value"
            >{s.value}<span
              class="pct"
              data-k-file={file}
              data-k-path={`imageBreak.stats.${i}.suffix`}
              data-k-value={s.suffix}
              data-k-kind="text"
              data-k-label="Stat suffix"
            >{s.suffix}</span></div>
            <div class="lead">
              <Editable as="span" file={file} path={`imageBreak.stats.${i}.text`} value={s.text} label="Stat text" />
              <Editable as="span" class="src" file={file} path={`imageBreak.stats.${i}.source`} value={s.source} label="Stat source" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
