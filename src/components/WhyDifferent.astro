---
import { getEntry } from 'astro:content';
import type { HomeData } from '../content.config';
import Editable from './Editable.astro';

const home = await getEntry('pages', 'home');
const { whyDifferent } = home!.data as HomeData;
const file = 'src/content/pages/home.json';
---

<section class="why" data-k-module-file={file} data-k-module-path="whyDifferent" data-k-module-label="Why different">
  <div class="container">
    <div class="section-head reveal">
      <Editable as="h2" kind="text" value={whyDifferent.heading} file={file} path="whyDifferent.heading" label="Why different heading" />
    </div>
    <div class="why-grid">
      {whyDifferent.rows.map((row, i) => (
        <div
          class="why-row reveal"
          style={`--reveal-delay:${i*85}ms`}
          data-k-module-file={file}
          data-k-module-path={`whyDifferent.rows.${i}`}
          data-k-module-label={`Why row ${i + 1}`}
        >
          <div class="head">
            <img class="why-icon" src={row.icon} alt="" width="52" height="52" loading="lazy" />
            <Editable as="div" class="ttl" file={file} path={`whyDifferent.rows.${i}.title`} value={row.title} label="Why row title" />
          </div>
          <Editable as="div" class="body" file={file} path={`whyDifferent.rows.${i}.body`} value={row.body} label="Why row body" />
        </div>
      ))}
    </div>

    <div class="why-closer" data-k-module-file={file} data-k-module-path="whyDifferent.closer" data-k-module-label="Why closer">
      <div class="why-closer-img">
        <video
          style="object-fit:cover;width:100%;height:100%;display:block"
          src={whyDifferent.closer.videoSrc}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          aria-label="Hume Edge team at work"
        ></video>
      </div>
      <div>
        <Editable as="h3" kind="html" value={whyDifferent.closer.headingHtml} file={file} path="whyDifferent.closer.headingHtml" label="Why closer heading" />
        <Editable as="p" kind="text" value={whyDifferent.closer.body} file={file} path="whyDifferent.closer.body" label="Why closer body" />
        <div class="firms">
          <Editable as="div" class="lab" kind="text" value={whyDifferent.closer.firmsLabel} file={file} path="whyDifferent.closer.firmsLabel" label="Why closer firms label" />
          <div class="firms-row">
            {whyDifferent.closer.firms.map((firm, i) => (
              <>
                <Editable as="span" file={file} path={`whyDifferent.closer.firms.${i}`} value={firm} label={`Firm ${i + 1}`} />
                {i < whyDifferent.closer.firms.length - 1 && <span>·</span>}
              </>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
