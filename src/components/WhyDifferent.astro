---
import { getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
const { whyDifferent } = home!.data;
---

<section class="why">
  <div class="container">
    <div class="section-head reveal">
      <h2>{whyDifferent.heading}</h2>
    </div>
    <div class="why-grid">
      {whyDifferent.rows.map((row, i) => (
        <div class="why-row reveal" style={`--reveal-delay:${i*85}ms`}>
          <div class="head">
            <img class="why-icon" src={row.icon} alt="" width="52" height="52" loading="lazy" />
            <div class="ttl">{row.title}</div>
          </div>
          <div class="body">{row.body}</div>
        </div>
      ))}
    </div>

    <div class="why-closer">
      <div class="why-closer-img">
        <video
          style="object-fit:cover;width:100%;height:100%;display:block"
          src={whyDifferent.closer.videoSrc}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          aria-label="Hume Edge team at work"
        ></video>
      </div>
      <div>
        <h3 set:html={whyDifferent.closer.headingHtml} />
        <p>
          {whyDifferent.closer.body}
        </p>
        <div class="firms">
          <div class="lab">{whyDifferent.closer.firmsLabel}</div>
          <div class="firms-row">
            {whyDifferent.closer.firms.map((firm, i) => (
              <>
                <span>{firm}</span>
                {i < whyDifferent.closer.firms.length - 1 && <span>·</span>}
              </>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
